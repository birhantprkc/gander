<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No permissions at all: files arrive via SAF or Open-with grants, rendering is fully offline.
         Media3 contributes ACCESS_NETWORK_STATE for streaming bitrate choice, stripped below because
         Gander only ever plays local files. The checkPermissions task fails the build on any others. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- Auto Backup is off because the only thing it could copy is worthless. The recents
         list is SAF content URIs, and Recents.all filters every entry against
         contentResolver.persistedUriPermissions; those grants are per install and do not
         survive a restore, so a restored list renders empty however faithfully it was
         backed up. Leaving it on sent file names and timestamps to the user's Drive to
         buy nothing, and put an asterisk on the one claim the app is built around.
         Thumbnails were never affected: cacheDir is excluded from backup already. -->
    <application
        android:name=".GanderApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gander">

        <!-- Lets the Share action hand out the shared-text temp file; grants are
             per-share and read-only, so the zero-permission story is unchanged -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ViewerActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/x-subrip" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <!-- The Office formats' relatives. A .docm and a .pptm twice over, because a
                     filter matches a type case-sensitively: Android 10 and later report every
                     type in lower case, while the registered spelling says macroEnabled and an
                     app passing on the type a file was sent with can use that. Lint wants lower
                     case only, which Android's documentation asks of senders too, so it is told
                     to let the registered spelling through, for the apps that send it anyway. -->
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.template" />
                <data android:mimeType="application/vnd.ms-word.document.macroEnabled.12" tools:ignore="AppLinkUrlError" />
                <data android:mimeType="application/vnd.ms-word.document.macroenabled.12" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.template" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.slideshow" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.template" />
                <data android:mimeType="application/vnd.ms-powerpoint.presentation.macroEnabled.12" tools:ignore="AppLinkUrlError" />
                <data android:mimeType="application/vnd.ms-powerpoint.presentation.macroenabled.12" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.text-template" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <!-- An STL, by every type it is sent as. The last is the one Android itself
                     gives a .stl, and so the one a file manager sends: see FileKind. -->
                <data android:mimeType="model/stl" />
                <data android:mimeType="model/x.stl-binary" />
                <data android:mimeType="model/x.stl-ascii" />
                <data android:mimeType="application/sla" />
                <data android:mimeType="application/vnd.ms-pki.stl" />
                <!-- A file an app knows only as binary. WhatsApp sends one whose type it has
                     no name for this way, a .stl among them, and shows it as BIN. Android
                     matches on the type alone, never the file's name, so this is the only way
                     Gander is offered one. Once it is here it goes by its name: see FileKind. -->
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/x-subrip" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <!-- As in the VIEW filter above, both spellings of .docm and .pptm. -->
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.template" />
                <data android:mimeType="application/vnd.ms-word.document.macroEnabled.12" tools:ignore="AppLinkUrlError" />
                <data android:mimeType="application/vnd.ms-word.document.macroenabled.12" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.template" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.slideshow" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.template" />
                <data android:mimeType="application/vnd.ms-powerpoint.presentation.macroEnabled.12" tools:ignore="AppLinkUrlError" />
                <data android:mimeType="application/vnd.ms-powerpoint.presentation.macroenabled.12" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.text-template" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="model/stl" />
                <data android:mimeType="model/x.stl-binary" />
                <data android:mimeType="model/x.stl-ascii" />
                <data android:mimeType="application/sla" />
                <data android:mimeType="application/vnd.ms-pki.stl" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- The viewer again, for a file inside a zip. Not exported, so only Gander can start
             it, and ViewerActivity refuses an archive URI that arrives any other way: see
             ViewerActivity.ENTRY_VIEWER for why. Declared after the activity it names, which
             an alias has to be. -->
        <activity-alias
            android:name=".ArchiveEntryViewer"
            android:exported="false"
            android:targetActivity=".ViewerActivity" />

        <!-- Serves a file inside a zip to the viewers, read straight out of the archive, issue
             #30. Not exported: Share hands one file's URI on with a one-off read grant, the
             same shape as the FileProvider above, so the zero-permission story is unchanged. -->
        <provider
            android:name=".ArchiveProvider"
            android:authorities="${applicationId}.archive"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
