<?xml version="1.0" encoding="utf-8"?>
<!-- The fast-scroll thumb. A selector rather than a tint set in code, which is the
     convention every fast scroller on Android follows; the drag handler sets the view
     pressed and this picks the colour up from that.

     Fixed colours and not a theme pair, for the same reason as page_pill_bg: what sits
     behind this is the document, not the app, so a colour that inverts with the app
     theme ends up pale grey on white paper. Dark fill for the paper, hairline light
     stroke for the slate a slide deck is drawn on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E62A2D31" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#992A2D31" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
