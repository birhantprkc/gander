<?xml version="1.0" encoding="utf-8"?>
<!-- The transport for an audio file.

     Media3's own controller is laid out for video: the seek bar and the clock are pinned
     to the very bottom edge so they do not cover the picture, and the play button floats
     in the middle of the screen on its own. On a track there is no picture to keep clear,
     so that leaves the bar stranded at the bottom with a screen of nothing between it and
     the button it belongs to. Here the three parts are one block: bar, then the clock
     under it, then the transport, sitting together below the cover art.

     The ids are media3's and are load bearing. exo_progress_placeholder in particular is
     not a widget: PlayerControlView finds this View and swaps a real DefaultTimeBar into
     its place, which is how the seek bar arrives without being named here. The two skip
     buttons are pulled in as media3's own layouts rather than declared, because they carry
     an amount drawn into the icon that is set up in code.

     The cover lives in here too, at the top of the same block, rather than being placed
     over the player separately. Positioned separately it was a fixed distance from the
     top of the screen while the transport was centred in it, and in landscape, where
     there is a third of the height, the two would have run into each other. In one
     column they cannot: the whole block centres together and shrinks together. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/audioCover"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="36dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_audio_placeholder" />

        <View
            android:id="@id/exo_progress_placeholder"
            android:layout_width="match_parent"
            android:layout_height="26dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                style="@style/ExoStyledControls.TimeText.Position" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@id/exo_duration"
                style="@style/ExoStyledControls.TimeText.Duration" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <include layout="@layout/exo_player_control_rewind_button" />

            <ImageButton
                android:id="@id/exo_play_pause"
                style="@style/ExoStyledControls.Button.Center.PlayPause" />

            <include layout="@layout/exo_player_control_ffwd_button" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
