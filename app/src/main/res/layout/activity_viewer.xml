<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        app:menu="@menu/viewer_menu"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextAppearance="?attr/textAppearanceTitleMedium" />

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/search_in_document"
            android:imeOptions="actionSearch"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/searchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/searchPrev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous_match"
            android:src="@drawable/ic_up" />

        <ImageButton
            android:id="@+id/searchNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next_match"
            android:src="@drawable/ic_down" />

        <ImageButton
            android:id="@+id/searchClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_search"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Sits between the toolbar and the document so a long save reports itself
         without covering what is being read. Gone unless a copy is running. -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/saveProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:trackCornerRadius="0dp" />

    <!-- The document, and the things that float over it.

         The overlays are siblings of the container rather than children of it because
         showRendererGone empties the container, and a page number left standing over
         the card that replaces a document would be a claim about something no longer
         on screen. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Which page of a PDF is on screen. Deliberately not a live region: the
             counter changes on every page crossed during a fling, and a region would
             read every one of them out. It is focusable and labelled instead, so a
             screen reader answers the question when asked rather than continuously. -->
        <TextView
            android:id="@+id/pageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/page_pill_bg"
            android:elevation="3dp"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="32dp"
            android:minWidth="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceInverse"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
