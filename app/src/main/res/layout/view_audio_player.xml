<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated rather than constructed, for one attribute: controller_layout_id has no
     setter on PlayerView, so the only way to give a track a transport of its own is from
     XML. Everything else about this view is still set in showPlayer. -->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:controller_layout_id="@layout/view_audio_controls" />
