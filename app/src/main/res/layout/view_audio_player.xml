<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated rather than constructed, for two attributes: neither controller_layout_id
     nor surface_type has a setter on PlayerView, so XML is the only way to set them.
     Everything else about this view is still set in showPlayer.

     surface_type="none" because a track has no video to put anywhere. Left at the default
     surface_view, PlayerView builds a SurfaceView, and a SurfaceView with nothing decoding
     into it is a black rectangle punched through the window: it covered the warm backdrop
     showPlayer sets on the container, so the screen measured #000000 everywhere except the
     strip below the transport, whatever setBackgroundColor and setShutterBackgroundColor
     were told. Neither reaches a surface. With no surface there is nothing to cover it. -->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:controller_layout_id="@layout/view_audio_controls"
    app:surface_type="none" />
